generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                       String     @id @default(uuid())
  email                    String     @unique
  name                     String?
  password                 String?
  role                     String     @default("USER")
  oauthProvider            String?
  oauthId                  String?
  profilePictureUrl        String?
  emailVerified            Boolean    @default(false)
  verificationTokenHash    String?
  verificationTokenExpires DateTime?
  resetTokenHash           String?
  resetTokenExpires        DateTime?
  refreshTokenHash         String?
  lastLogin                DateTime?
  isActive                 Boolean    @default(true)
  createdAt                DateTime   @default(now())
  updatedAt                DateTime   @updatedAt
  files                    File[]
  logs                     AuditLog[]
}

model File {
  id                String   @id @default(uuid())
  name              String
  size              Int
  encryptedSize     Int?
  mimeType          String
  r2Key             String   @unique
  encryptedKey      String?
  iv                String?
  authTag           String?
  encryptionVersion Int      @default(1)
  keyVersion        Int      @default(1)
  ownerId           String
  owner             User     @relation(fields: [ownerId], references: [id])
  shares            Share[]
  inTrash           Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  logs              AuditLog[]
}

model AuditLog {
  id        String   @id @default(uuid())
  action    String
  details   String
  userId    String?
  fileId    String?
  user      User?    @relation(fields: [userId], references: [id])
  file      File?    @relation(fields: [fileId], references: [id])
  createdAt DateTime @default(now())
}

model SupabaseAuditLog {
  id           String   @id @default(uuid())
  shareId      String?  @map("share_id")
  fileName     String?  @map("file_name")
  sharedBy     String?  @map("shared_by")
  recipient    String?  
  action       String   
  encryption   String?  
  downloadType String?  @map("download_type")
  timestamp    DateTime @default(now())
  status       String   

  @@map("audit_logs")
}

model Share {
  id                        String    @id @default(uuid())
  token                     String    @unique
  fileId                    String
  file                      File      @relation(fields: [fileId], references: [id], onDelete: Cascade)
  password                  String?   // Optional decryption password
  expiresAt                 DateTime? // Optional expiration
  revoked                   Boolean   @default(false)
  downloadsCount            Int       @default(0)
  downloadsLimit            Int       @default(5)
  recipientEmail            String?
  emailVerificationRequired Boolean   @default(false) // Future-ready email verification
  verificationOtp           String?   // Future-ready OTP
  verificationOtpExpires    DateTime? // Future-ready OTP expiration
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt
}



