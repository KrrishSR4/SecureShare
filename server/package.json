{
  "name": "secureshare-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "db:push": "prisma db push",
    "db:generate": "prisma generate",
    "typecheck": "tsc --noEmit",
    "lint": "echo 'No server linting configured'",
    "test:unit": "node --import tsx --test src/index.unit.ts",
    "test:integration": "node --import tsx --test src/index.integration.ts"
  },
  "dependencies": {
    "@prisma/client": "^7.10.1",
    "@supabase/supabase-js": "^2.118.0",
    "bcryptjs": "^3.0.3",
    "busboy": "^1.6.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "google-auth-library": "^11.3.1",
    "helmet": "^8.3.0",
    "hono": "^4.13.13",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.12.1",
    "multer": "^2.4.0",
    "nodemailer": "^10.1.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/busboy": "^1.5.4",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.5.1",
    "prisma": "^7.10.0",
    "tsx": "^4.23.13",
    "typescript": "^5.8.2"
  }
}
